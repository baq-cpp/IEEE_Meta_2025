  m_Name: 
  m_EditorClassIdentifier: 
  allHints:
  - title: 'Hint #1: Setting up Inputs'
    details: 'A. Establish a jumper wire to connect VCC to a terminal strip

      -
      Repeat til 3 terminal strips are set up (TOP (A), MIDDLE (B), BOTTOM (C))

'
  - title: 'Hint #2: Setting up BC'
    details: "A. Place AND Gate on the board\r\n - Establish a wire from pin 7 to
      ground (refer to the PINOUT VIEW OF AND)\r\n- Establish a wire from pin 14
      to VCC (refer to the PINOUT VIEW OF AND)\r\n- Establish a wire from the terminal
      strip (B) to AND_pin1 (INPUT B)\r\n- Establish a wire from the terminal strip
      (C) to AND_pin2 (INPUT C)\r\n- Establish a wire from the terminal strip AND_pin3
      to AND_pin13 (OUTPUT BC to INPUT BCA\u2019)\r\n- Establish a wire from the
      terminal strip AND_pin3 to NOT_pin13 (OUTPUT BC to INPUT NOT)\r\n"
  - title: 'Hint #3: Setting up BC'
    details: 'Place OR Gate on the Board

      - Establish a wire from pin 7 to
      ground (refer to the PINOUT VIEW OF OR)

      - Establish a wire from pin
      14 to VCC (refer to the PINOUT VIEW OF OR)

      - Establish a wire from the
      terminal strip (A) to OR_pin1 (Input A)

      - Establish a wire from the
      terminal strip AND_pin3 to OR_pin2 (Input  BC)

      - Establish a wire from
      the terminal strip OR_pin3 to (OUTPUT A + BC)

'
  - title: Hint #4
    details: "Place a NOT Gate on the Board\r\n- Establish a wire from pin 7 to ground
      (refer to the PINOUT VIEW OF NOT)\r\n- Establish a wire from pin 14 to VCC
      (refer to the PINOUT VIEW OF NOT)\r\n- Establish a wire from the terminal strip
      (A) to NOT_pin1 (INPUT A)\r\n- Establish a wire from the terminal strip NOT_pin2
      to AND_pin14 (OUTPUT A TO INPUT BCA\u2019)\r\n"
  - title: Hint #5
    details: Hint 5 Details
